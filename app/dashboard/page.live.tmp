'use client'
import Link from 'next/link'
import { useEffect, useState } from 'react'
const money=(v:number)=>`₦${Number(v||0).toLocaleString('en-NG',{minimumFractionDigits:2})}`
export default function DashboardPage(){const[name,setName]=useState('User');const[loading,setLoading]=useState(true);const[error,setError]=useState(false);const[data,setData]=useState({walletBalance:0,activeGroups:0,totalPayouts:0,pendingPayouts:0});useEffect(()=>{Promise.all([fetch('/api/auth/session',{cache:'no-store'}),fetch('/api/dashboard',{cache:'no-store'})]).then(async([s,d])=>{if(s.status===401||d.status===401){window.location.replace('/login');return}const session=s.ok?await s.json():null;const dash=d.ok?await d.json():null;if(session?.name)setName(session.name);if(dash?.authenticated)setData({walletBalance:dash.wallet?.balance??0,activeGroups:dash.activeGroups??0,totalPayouts:dash.totalPayouts??0,pendingPayouts:dash.pendingPayouts??0});else setError(true)}).catch(()=>setError(true)).finally(()=>setLoading(false))},[]);const cards=[['Wallet Balance',money(data.walletBalance),'Available Balance'],['Active Groups',String(data.activeGroups),"Groups you're part of"],['Total Payouts',money(data.totalPayouts),'Total received'],['Pending Payouts',money(data.pendingPayouts),'Awaiting your turn']];return <div className="min-h-screen bg-[#f8faf9] text-gray-900"><aside className="hidden lg:flex w-[250px] min-h-screen bg-[#0b2313] text-white p-5 fixed inset-y-0 left-0 flex-col"><div className="text-[26px] font-extrabold">Alajo</div><nav className="mt-8 flex-1 space-y-1">{[['Dashboard','/dashboard'],['Groups','/groups'],['Contributions','/contributions'],['Payouts','/payouts'],['Wallet','/wallet'],['Transactions','/transactions'],['Invite & Earn','/invite-earn'],['Notifications','/notifications'],['Settings','/settings'],['Help Center','/help-center']].map(([label,href])=><Link key={label} href={href} className={`block px-3 py-2.5 rounded-lg ${label==='Dashboard'?'bg-white/10 text-white':'text-gray-300 hover:bg-white/5'}`}>{label}</Link>)}</nav><Link href="/login" className="text-gray-300 block px-3 py-2.5">Logout</Link></aside><main className="lg:ml-[250px]"><header className="h-[76px] bg-white border-b px-5 sm:px-8 flex items-center justify-between"><div><p className="text-gray-400 text-[13px]">Dashboard</p><h1 className="font-semibold text-[18px]">Good morning, {name}</h1></div><div className="w-9 h-9 rounded-full bg-gray-200 flex items-center justify-center font-semibold">{name.charAt(0).toUpperCase()}</div></header><section className="p-5 sm:p-8"><p className="text-gray-500 text-[14px]">Here&apos;s what&apos;s happening with your savings today</p>{error&&<div className="mt-4 rounded-lg bg-red-50 border border-red-100 px-4 py-3 text-sm text-red-600">We couldn&apos;t load your latest dashboard data. Please refresh.</div>}<div className="mt-6 grid grid-cols-2 xl:grid-cols-4 gap-5">{cards.map(([label,value,sub])=><div key={label} className="bg-white rounded-xl border p-5"><p className="text-gray-500 text-[13px]">{label}</p><p className="text-[20px] font-bold mt-2">{loading?'—':value}</p><p className="text-[12px] text-gray-400 mt-1">{sub}</p></div>)}</div><div className="mt-6 grid grid-cols-1 xl:grid-cols-2 gap-5"><div className="bg-white rounded-xl border p-5"><div className="flex justify-between"><h2 className="font-semibold">Recent Activity</h2><Link href="/transactions" className="text-[#16a34a] text-[13px]">View All</Link></div><p className="mt-5 text-sm text-gray-500">Your recent savings activity will appear here.</p></div><div className="bg-white rounded-xl border p-5"><div className="flex justify-between"><h2 className="font-semibold">My Active Groups</h2><Link href="/groups" className="text-[#16a34a] text-[13px]">View All Groups</Link></div><p className="mt-5 text-sm text-gray-500">Open Groups to view your savings groups.</p></div></div></section></main></div>}
